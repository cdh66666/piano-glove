<Configuration>
  <!-- Windows 沙盒：一台全新的、关掉就清空的电脑。只读挂进 D:\cc_work，开机自动复制钢琴手套.exe 到桌面并打开。 -->
  <VGpu>Enable</VGpu>
  <Networking>Enable</Networking>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\cc_work</HostFolder>
      <SandboxFolder>C:\host</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd /c copy "C:\host\钢琴手套.exe" "C:\Users\WDAGUtilityAccount\Desktop\钢琴手套.exe" &amp;&amp; start "" "C:\Users\WDAGUtilityAccount\Desktop\钢琴手套.exe"</Command>
  </LogonCommand>
</Configuration>
